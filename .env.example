# Copy to .env and fill in. Never commit .env.

# --- data bundle (tools/s3_bundle.py) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# FGR_S3_BUCKET=banktransactiondata
# FGR_S3_PREFIX=fastgraphretriever/bundle/v1/

# --- neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# --- api ---
BUNDLE_DIR=/data/bundle
RUNTIME_DIR=/data/runtime
TORCH_THREADS=4
RETRIEVE_MAX_TRIPLES=10000
HOP1_CAP=5000
FANOUT_CAP=200
RT_PRIORITY=50

# --- llm (mock by default; live calls are capped by LLM_BUDGET_USD over the ledger's lifetime) ---
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_BUDGET_USD=0.05
LLM_PRICE_IN_HIT=0.006
LLM_PRICE_IN_MISS=0.30
LLM_PRICE_OUT=1.20
